generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
}

enum CategoryKind {
  SCHOOL
  GENERAL
  JOB
  PERSONAL
  PEOPLE
  BUSINESS
  LEARNING
}

enum GoalHorizon {
  SEASON
  ONE_YEAR
  FIVE_YEAR
}

enum GoalStatus {
  ACTIVE
  DONE
  PAUSED
  ARCHIVED
}

enum ProjectKind {
  GENERAL
  CLASS
  BUSINESS
  LEARNING
  JOB
  PERSONAL
}

enum ProjectStatus {
  ACTIVE
  SOMEDAY
  DONE
  ARCHIVED
}

enum TaskStatus {
  INBOX
  TODO
  DOING
  WAITING
  DONE
  CANCELED
}

enum TaskKind {
  TASK
  ASSIGNMENT
  EXAM
  STUDY
  SHIFT_DELIVERABLE
  FOLLOW_UP
  APPOINTMENT
  PAPERWORK
  PRACTICE
}

enum Effort {
  LOW
  MEDIUM
  HIGH
}

enum RecurrenceRule {
  NONE
  DAILY
  WEEKLY
  MONTHLY
  EVERY_N_DAYS
}

enum CommitmentDirection {
  I_PROMISED
  THEY_PROMISED
}

enum CommitmentStatus {
  OPEN
  DONE
  DROPPED
}

enum EventKind {
  CLASS
  SHIFT
  APPOINTMENT
  SHARED_PLAN
  STUDY_BLOCK
  OTHER
}

enum NoteKind {
  NOTE
  IDEA
  MEETING
  REFLECTION
  RESOURCE
}

enum MoneyKind {
  INCOME
  BILL
  SUBSCRIPTION
  SAVINGS_GOAL
}

enum ExperimentStatus {
  PLANNED
  RUNNING
  COMPLETE
  CANCELED
}

enum PrioritizationMethod {
  TOP3
  EISENHOWER
  ABCDE
}

model User {
  id             String          @id @default(cuid())
  email          String          @unique
  passwordHash   String
  name           String?
  role           UserRole        @default(OWNER)
  active         Boolean         @default(true)
  sessionVersion Int             @default(0)
  isSample       Boolean         @default(false)
  createdAt      DateTime        @default(now())
  categories     Category[]
  goals          Goal[]
  projects       Project[]
  tasks          Task[]
  people         Person[]
  commitments    Commitment[]
  events         CalendarEvent[]
  notes          Note[]
  moneyItems     MoneyItem[]
  experiments    Experiment[]
  weeklyReviews  WeeklyReview[]
  settings       Settings?
}

model LoginRateLimit {
  id              String   @id @default(cuid())
  email           String
  ip              String
  failures        Int      @default(0)
  windowStartedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([email, ip])
  @@index([updatedAt])
}

model Category {
  id        String          @id @default(cuid())
  userId    String
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  kind      CategoryKind    @default(GENERAL)
  color     String          @default("#8b5cf6")
  icon      String          @default("circle")
  sortOrder Int             @default(0)
  archived  Boolean         @default(false)
  isSample  Boolean         @default(false)
  createdAt DateTime        @default(now())
  projects  Project[]
  tasks     Task[]
  events    CalendarEvent[]
  notes     Note[]
  goals     Goal[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

model Goal {
  id                String      @id @default(cuid())
  userId            String
  user              User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  description       String      @default("")
  horizon           GoalHorizon
  seasonLabel       String?
  categoryId        String?
  category          Category?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  parentGoalId      String?
  parentGoal        Goal?       @relation("GoalTree", fields: [parentGoalId], references: [id], onDelete: SetNull)
  children          Goal[]      @relation("GoalTree")
  status            GoalStatus  @default(ACTIVE)
  targetDate        DateTime?
  successDefinition String      @default("")
  isSample          Boolean     @default(false)
  createdAt         DateTime    @default(now())
  projects          Project[]
  notes             Note[]

  @@index([userId, horizon])
}

model Project {
  id                String          @id @default(cuid())
  userId            String
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title             String
  categoryId        String
  category          Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  goalId            String?
  goal              Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  kind              ProjectKind     @default(GENERAL)
  status            ProjectStatus   @default(ACTIVE)
  outcome           String          @default("")
  successDefinition String          @default("")
  financialTarget   Int?
  startDate         DateTime?
  targetDate        DateTime?
  courseCode        String?
  instructor        String?
  scheduleText      String?
  term              String?
  valueScore        Int?
  effortScore       Int?
  costScore         Int?
  interestScore     Int?
  timingScore       Int?
  isSample          Boolean         @default(false)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  milestones        Milestone[]
  tasks             Task[]
  events            CalendarEvent[]
  notes             Note[]
  commitments       Commitment[]
  moneyItems        MoneyItem[]
  experiments       Experiment[]

  @@index([userId, status])
  @@index([categoryId])
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title     String
  dueDate   DateTime?
  done      Boolean   @default(false)
  isSample  Boolean   @default(false)
  createdAt DateTime  @default(now())

  @@index([projectId, dueDate])
}

model Task {
  id                 String           @id @default(cuid())
  userId             String
  user               User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  notes              String           @default("")
  categoryId         String?
  category           Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projectId          String?
  project            Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parentTaskId       String?
  parentTask         Task?            @relation("TaskTree", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks           Task[]           @relation("TaskTree")
  status             TaskStatus       @default(INBOX)
  effort             Effort           @default(MEDIUM)
  priority           Int              @default(2)
  position           Float            @default(0)
  dueDate            DateTime?
  plannedDate        DateTime?
  estimateMinutes    Int              @default(30)
  pinnedToday        Boolean          @default(false)
  topPriorityOn      DateTime?
  recurrence         RecurrenceRule   @default(NONE)
  recurrenceEvery    Int?
  recurrenceWeekdays Int[]            @default([])
  waitingOnPersonId  String?
  waitingOnPerson    Person?          @relation("WaitingOnPerson", fields: [waitingOnPersonId], references: [id], onDelete: SetNull)
  followUpDate       DateTime?
  kind               TaskKind         @default(TASK)
  completedAt        DateTime?
  recurringFromId    String?
  isSample           Boolean          @default(false)
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
  steps              TaskStep[]
  people             TaskPerson[]
  events             CalendarEvent[]
  commitments        Commitment[]
  notesLinked        Note[]           @relation("TaskNotes")
  blockedBy          TaskDependency[] @relation("BlockedTask")
  blocks             TaskDependency[] @relation("BlockerTask")

  @@index([userId, status])
  @@index([dueDate])
  @@index([plannedDate])
  @@index([projectId])
}

model TaskStep {
  id        String    @id @default(cuid())
  taskId    String
  task      Task      @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title     String
  done      Boolean   @default(false)
  position  Float     @default(0)
  createdAt DateTime  @default(now())
  doneAt    DateTime?

  @@index([taskId, position])
}

model TaskPerson {
  taskId   String
  personId String
  task     Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  person   Person @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@id([taskId, personId])
}

model TaskDependency {
  id        String   @id @default(cuid())
  blockerId String
  blockedId String
  blocker   Task     @relation("BlockerTask", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   Task     @relation("BlockedTask", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
}

model Person {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  relationship String          @default("")
  contact      String          @default("")
  notes        String          @default("")
  isSample     Boolean         @default(false)
  createdAt    DateTime        @default(now())
  commitments  Commitment[]
  notesLinked  Note[]
  taskPeople   TaskPerson[]
  waitingTasks Task[]          @relation("WaitingOnPerson")
  events       CalendarEvent[]

  @@index([userId, name])
}

model Commitment {
  id           String              @id @default(cuid())
  userId       String
  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  personId     String?
  person       Person?             @relation(fields: [personId], references: [id], onDelete: SetNull)
  direction    CommitmentDirection
  description  String
  dueDate      DateTime?
  followUpDate DateTime?
  status       CommitmentStatus    @default(OPEN)
  projectId    String?
  project      Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId       String?
  task         Task?               @relation(fields: [taskId], references: [id], onDelete: SetNull)
  isSample     Boolean             @default(false)
  createdAt    DateTime            @default(now())

  @@index([userId, direction, status])
  @@index([dueDate])
}

model CalendarEvent {
  id                 String    @id @default(cuid())
  userId             String
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title              String
  start              DateTime
  end                DateTime
  categoryId         String?
  category           Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projectId          String?
  project            Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId             String?
  task               Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)
  personId           String?
  person             Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  kind               EventKind @default(OTHER)
  location           String    @default("")
  recurrenceWeekly   Boolean   @default(false)
  recurrenceWeekdays Int[]     @default([])
  isSample           Boolean   @default(false)
  createdAt          DateTime  @default(now())

  @@index([userId, start])
}

model Note {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  body       String    @default("")
  kind       NoteKind  @default(NOTE)
  url        String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  projectId  String?
  project    Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  taskId     String?
  task       Task?     @relation("TaskNotes", fields: [taskId], references: [id], onDelete: SetNull)
  goalId     String?
  goal       Goal?     @relation(fields: [goalId], references: [id], onDelete: SetNull)
  personId   String?
  person     Person?   @relation(fields: [personId], references: [id], onDelete: SetNull)
  triagedAt  DateTime?
  isSample   Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@index([userId, triagedAt])
}

model MoneyItem {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        MoneyKind
  name        String
  amountCents Int       @default(0)
  cadence     String    @default("monthly")
  dueDay      Int?
  nextDate    DateTime?
  targetCents Int?
  savedCents  Int?
  projectId   String?
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)
  isSample    Boolean   @default(false)
  createdAt   DateTime  @default(now())

  @@index([userId, kind])
}

model Experiment {
  id             String           @id @default(cuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  projectId      String?
  project        Project?         @relation(fields: [projectId], references: [id], onDelete: SetNull)
  hypothesis     String
  budgetCents    Int              @default(0)
  startDate      DateTime?
  deadline       DateTime?
  successMeasure String           @default("")
  result         String           @default("")
  status         ExperimentStatus @default(PLANNED)
  isSample       Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([userId, status])
}

model WeeklyReview {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  weekStart     DateTime
  wentWell      String    @default("")
  didntGo       String    @default("")
  learned       String    @default("")
  nextWeekFocus String    @default("")
  completedAt   DateTime?
  isSample      Boolean   @default(false)
  createdAt     DateTime  @default(now())

  @@unique([userId, weekStart])
}

model Settings {
  id                   String               @id @default(cuid())
  userId               String               @unique
  user                 User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  timezone             String               @default("America/New_York")
  weekStartsOn         Int                  @default(1)
  prioritizationMethod PrioritizationMethod @default(TOP3)
  dailyCapacityHours   Float                @default(6)
  weeklyAvailableHours Float                @default(30)
  setupAreasDone       Boolean              @default(false)
  setupClassesDone     Boolean              @default(false)
  setupJobDone         Boolean              @default(false)
  setupTimezoneDone    Boolean              @default(false)
  setupPrioritiesDone  Boolean              @default(false)
  setupRemindersDone   Boolean              @default(false)
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
}
