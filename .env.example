# Database. Supabase: pooled URL on port 6543 with pgbouncer=true, plus direct port 5432.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true&schema=life"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?schema=life"
# Optional aliases supported by the database URL helper.
POSTGRES_PRISMA_URL=""
POSTGRES_URL=""
POSTGRES_URL_NON_POOLING=""
DATABASE_URL_UNPOOLED=""

AUTH_SECRET="replace-with-a-long-random-secret"
SESSION_SECRET=""
ADMIN_EMAIL="maribel@example.com"
ADMIN_PASSWORD="choose-a-strong-password"
APP_URL="http://localhost:3000"
APP_TIMEZONE="America/New_York"
CRON_SECRET="replace-with-a-long-random-secret"
NOTIFY_TO="maribel@example.com"
GMAIL_USER=""
GMAIL_APP_PASSWORD=""
# Development only; never used on Vercel.
EMAIL_OUTBOX_FILE=""
